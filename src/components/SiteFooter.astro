---
import { company } from "../data/company";

const navigation = [
  { label: "صفحه اصلی", href: "/" },
  { label: "محصولات", href: "/products/" },
  { label: "درباره ما", href: "/about/" },
  { label: "تماس با ما", href: "/contact/" },
  { label: "حریم خصوصی", href: "/privacy/" },
];
---

<footer class="bg-brand-navy text-white">
  <div class="mx-auto grid max-w-[1280px] grid-cols-1 gap-9 px-4 py-10 sm:px-6 md:grid-cols-2 lg:grid-cols-[1.25fr_0.7fr_1.2fr] lg:gap-12 lg:px-8 lg:py-12">
    <section aria-labelledby="footer-company-title">
      <a href="/" class="inline-flex items-center gap-3" aria-label={`${company.name}، صفحه اصلی`}>
        <span class="brand-mark h-12 w-12 rounded-lg border-0"><img src="/Logo.png" alt={`نشان تصویری ${company.name}`} width="512" height="512" loading="lazy" /></span>
        <span>
          <span id="footer-company-title" class="block text-base font-black">{company.name}</span>
          <span class="mt-1 block text-[10px] text-white/55">کاتالوگ همکاری تجاری</span>
        </span>
      </a>
      <p class="mt-4 max-w-sm text-xs leading-7 text-white/65">معرفی محصولات مرتبط با پمپ بنزین و مجموعه درجه باک خودرو برای فروشگاه‌ها، توزیع‌کنندگان و خریداران تجاری.</p>
    </section>

    <nav aria-labelledby="footer-navigation-title">
      <h2 id="footer-navigation-title" class="text-xs font-black text-cta-gold">دسترسی سریع</h2>
      <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 text-xs sm:grid-cols-1">
        {navigation.map((item) => <li><a href={item.href} class="text-white/65 transition hover:text-cta-gold">{item.label}</a></li>)}
      </ul>
    </nav>

    <section aria-labelledby="footer-contact-title">
      <h2 id="footer-contact-title" class="text-xs font-black text-cta-gold">اطلاعات تماس</h2>
      <dl class="mt-4 space-y-3 text-xs leading-6 text-white/70">
        <div>
          <dt class="inline font-bold text-white">تلفن فروش: </dt>
          <dd class="inline"><a href={`tel:${company.phone}`} dir="ltr" class="inline-block transition hover:text-cta-gold">{company.phoneDisplay}</a></dd>
        </div>
        <div><dt class="font-bold text-white">نشانی</dt><dd class="mt-1">{company.address}</dd></div>
        <div>
          <dt class="font-bold text-white">ساعت کاری</dt>
          <dd class="mt-1 space-y-1">
            {company.workingHours.map((item) => <p>{item.days}: {item.hours}</p>)}
          </dd>
        </div>
      </dl>
    </section>
  </div>
  <div class="border-t border-white/10 px-4 py-4 text-center text-[10px] text-white/45 sm:px-6">
    © {new Date().getFullYear()} {company.name}
  </div>
</footer>
