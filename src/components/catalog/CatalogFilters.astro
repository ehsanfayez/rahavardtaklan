---
import { options, type CatalogProduct } from "../../lib/catalog";
interface Props { products: CatalogProduct[] }
const { products } = Astro.props;
const available = options(products);
---
<details class="catalog-filters rounded-card border border-border-subtle bg-white shadow-soft" open>
  <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 text-base font-black text-content">
    <span class="inline-flex items-center gap-2"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="1.7"><path d="M3 4h18l-7 8v7l-4 2v-9L3 4Z" stroke-linejoin="round"/><path d="M7 8h10"/></svg>فیلتر محصولات</span>
    <span aria-hidden="true" class="catalog-filter-chevron text-content-muted">⌄</span>
  </summary>
  <form id="catalog-filters" action="/products/" method="get" class="space-y-5 border-t border-border-subtle px-5 pt-5 pb-5">
    <div>
      <label for="catalog-search" class="mb-2 block text-sm font-bold text-content">جست‌وجو</label>
      <input id="catalog-search" name="q" type="search" maxlength="120" autocomplete="off" aria-describedby="catalog-search-help" placeholder="نام یا کد محصول..." class="catalog-control" />
      <p id="catalog-search-help" class="mt-2 text-xs leading-5 text-content-muted">بر اساس نام و کدهای موجود محصول</p>
    </div>
    <div>
      <label for="catalog-category" class="mb-2 block text-sm font-bold text-content">دسته‌بندی</label>
      <select id="catalog-category" name="category" class="catalog-control" disabled={!available.categories.length}>
        <option value="">{available.categories.length ? "همه دسته‌بندی‌ها" : "داده تأییدشده موجود نیست"}</option>
        {available.categories.map(value => <option value={value}>{value}</option>)}
      </select>
    </div>
    <div>
      <label for="catalog-brand" class="mb-2 block text-sm font-bold text-content">برند خودرو</label>
      <select id="catalog-brand" name="brand" class="catalog-control" disabled={!available.brands.length}>
        <option value="">{available.brands.length ? "همه برندها" : "داده تأییدشده موجود نیست"}</option>
        {available.brands.map(value => <option value={value}>{value}</option>)}
      </select>
    </div>
    <div>
      <label for="catalog-model" class="mb-2 block text-sm font-bold text-content">مدل خودرو</label>
      <select id="catalog-model" name="model" class="catalog-control" disabled={!available.models.length}>
        <option value="">{available.models.length ? "همه مدل‌ها" : "داده تأییدشده موجود نیست"}</option>
        {available.models.map(value => <option value={value}>{value}</option>)}
      </select>
    </div>
    <div class="space-y-2.5 pt-1">
      <button type="submit" class="flex min-h-11 w-full items-center justify-center gap-2 rounded-control bg-cta-gold px-4 py-2.5 text-sm font-bold text-brand-navy transition hover:bg-cta-gold-hover"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="1.8"><path d="M3 4h18l-7 8v7l-4 2v-9L3 4Z" stroke-linejoin="round"/></svg>اعمال فیلتر</button>
      <a href="/products/" data-catalog-reset class="flex min-h-11 w-full items-center justify-center gap-2 rounded-control border border-border-strong px-3 py-2 text-sm text-content transition hover:border-cta-gold"><span aria-hidden="true">↻</span>پاک کردن فیلترها</a>
    </div>
  </form>
</details>
