---
import { company } from "../data/company";

interface Props { activePath?: string }
const { activePath = "/" } = Astro.props;

const navigation = [
  { label: "صفحه اصلی", href: "/" },
  { label: "محصولات", href: "/products/" },
  { label: "درباره ما", href: "/about/" },
  { label: "تماس با ما", href: "/contact/" },
];

const phoneHref = `tel:${company.phone}`;
---

<header class="relative z-30 bg-brand-navy text-white shadow-[0_8px_28px_rgba(4,12,19,.15)]">
  <div class="border-b border-white/10 bg-brand-navy-deep">
    <div class="mx-auto flex max-w-[1320px] flex-col gap-1 px-4 py-1.5 text-[9px] text-white/65 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5">
        <a href={phoneHref} dir="ltr" class="inline-flex items-center gap-2 transition hover:text-cta-gold">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-none stroke-current" stroke-width="1.8"><path d="M7 3H4.8A1.8 1.8 0 0 0 3 4.8C3 13.7 10.3 21 19.2 21a1.8 1.8 0 0 0 1.8-1.8V17l-4.6-1.2-1.7 2.2a16 16 0 0 1-6.7-6.7L10.2 9 9 4.4 7 3Z" stroke-linejoin="round" /></svg>
          {company.phoneDisplay}
        </a>
        <span class="hidden max-w-[18rem] items-center gap-2 truncate md:inline-flex xl:max-w-none">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-none stroke-current" stroke-width="1.8"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.2"/></svg>
          {company.address}
        </span>
      </div>
      <span class="hidden items-center gap-2 md:inline-flex">ساعات پاسخ‌گویی: {company.workingHours[0].days}، {company.workingHours[0].hours}</span>
    </div>
  </div>

  <div class="mx-auto flex max-w-[1320px] items-center justify-between gap-2 px-4 py-2 sm:px-6 lg:px-8">
    <a href="/" class="flex min-w-0 shrink-0 items-center gap-2.5" aria-label={`${company.name}، صفحه اصلی`}>
      <span class="brand-mark h-10 w-10 shrink-0 rounded-md border-0 sm:h-11 sm:w-11"><img src="/Logo.png" alt="" width="512" height="512" /></span>
      <span class="min-w-0">
        <span class="block truncate text-sm font-black tracking-tight text-white sm:text-lg">{company.name}</span>
        <span class="mt-0.5 hidden text-[10px] text-white/55 sm:block">تأمین‌کننده قطعات خودرو</span>
      </span>
    </a>

    <nav class="hidden shrink-0 items-center gap-0.5 lg:flex xl:gap-1" aria-label="ناوبری اصلی">
      {navigation.map((item) => <a href={item.href} aria-current={item.href === activePath ? "page" : undefined} class:list={["relative rounded-lg px-1.5 py-2 text-[10px] font-bold transition hover:text-cta-gold xl:px-3 xl:text-xs", item.href === activePath ? "text-cta-gold after:absolute after:inset-x-2 after:-bottom-1 after:h-0.5 after:bg-cta-gold" : "text-white/80"]}>{item.label}</a>)}
    </nav>

    <form role="search" action="/products/" method="get" class="hidden min-w-0 w-full max-w-[145px] shrink items-center rounded-full border border-white/15 bg-white/[0.06] px-2.5 py-2 transition focus-within:border-cta-gold/70 lg:flex xl:max-w-[205px] xl:px-3">
      <label for="featured-product-search" class="sr-only">جست‌وجو در محصولات</label>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 shrink-0 fill-none stroke-white/55" stroke-width="1.8"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.2 4.2" stroke-linecap="round"/></svg>
      <input id="featured-product-search" name="q" type="search" autocomplete="off" placeholder="جست‌وجو در محصولات..." class="min-w-0 flex-1 bg-transparent px-2 text-[11px] text-white outline-none placeholder:text-white/45" />
    </form>

    <div class="flex shrink-0 items-center gap-2">
      <a href="/contact/" class="hidden min-h-9 items-center gap-2.5 rounded-control bg-cta-gold px-4 py-2 text-[11px] font-black text-brand-navy-deep shadow-sm transition hover:-translate-y-0.5 hover:bg-cta-gold-hover hover:shadow-md focus-visible:outline-white sm:inline-flex">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="1.8"><path d="M7 3H4.8A1.8 1.8 0 0 0 3 4.8C3 13.7 10.3 21 19.2 21a1.8 1.8 0 0 0 1.8-1.8V17l-4.6-1.2-1.7 2.2a16 16 0 0 1-6.7-6.7L10.2 9 9 4.4 7 3Z" stroke-linejoin="round" /></svg>
        <span>ارتباط با واحد فروش</span>
      </a>
      <details class="group relative lg:hidden">
        <summary class="flex h-9 cursor-pointer list-none items-center gap-2 rounded-lg border border-white/20 px-3 text-xs font-bold text-white transition hover:border-cta-gold hover:text-cta-gold focus-visible:outline-offset-2" aria-label="باز کردن منوی اصلی">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" /></svg><span class="hidden sm:inline">فهرست</span>
        </summary>
        <nav class="absolute left-0 top-12 flex w-[min(18rem,calc(100vw-2rem))] flex-col gap-1 rounded-xl border border-white/10 bg-[#07121b] p-2 shadow-xl" aria-label="ناوبری موبایل">
          {navigation.map((item) => <a href={item.href} aria-current={item.href === activePath ? "page" : undefined} class:list={["rounded-lg px-3 py-3 text-sm font-semibold text-white/85 transition hover:bg-white/5 hover:text-[#ffbd24]", item.href === activePath && "bg-white/5 text-cta-gold"]}>{item.label}</a>)}
          <a href="/contact/" class="mt-1 inline-flex items-center gap-2 rounded-lg bg-cta-gold px-3 py-3 text-sm font-black text-brand-navy-deep transition hover:bg-cta-gold-hover">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="1.8"><path d="M7 3H4.8A1.8 1.8 0 0 0 3 4.8C3 13.7 10.3 21 19.2 21a1.8 1.8 0 0 0 1.8-1.8V17l-4.6-1.2-1.7 2.2a16 16 0 0 1-6.7-6.7L10.2 9 9 4.4 7 3Z" stroke-linejoin="round" /></svg>
            ارتباط با واحد فروش
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
