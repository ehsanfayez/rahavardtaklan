---
import { company } from "../../data/company";
const { latitude, longitude } = company.location;
const coordinates = `${latitude},${longitude}`;
const mapLinks = [
  { label: "نشان", href: `https://neshan.org/maps#c${latitude}-${longitude}-17z-0p` },
  { label: "بلد", href: `https://balad.ir/location?latitude=${latitude}&longitude=${longitude}&zoom=17` },
  { label: "Google Maps", href: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(coordinates)}` },
];
---
<div class="space-y-4">
  <section class="contact-panel" aria-labelledby="contact-information-title">
    <h2 id="contact-information-title" class="contact-section-title"><span aria-hidden="true" class="h-0.5 w-6 bg-cta-gold"></span>اطلاعات تماس</h2>
    <p class="mt-2 text-sm leading-7 text-content-muted">راه‌های ارتباط با واحد فروش {company.name}</p>
    <dl class="mt-4 divide-y divide-border-subtle">
      <div class="contact-information-row">
        <span class="contact-information-icon"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current" stroke-width="1.8"><path d="m7 3 3 5-2.2 2.2a15 15 0 0 0 6 6L16 14l5 3-1 4C10 22 2 14 3 4l4-1Z" stroke-linejoin="round"/></svg></span>
        <div class="min-w-0"><dt class="text-sm font-bold">تماس با واحد فروش</dt><dd class="mt-1"><a href={`tel:${company.phone}`} dir="ltr" class="inline-flex min-h-8 items-center text-lg font-semibold transition hover:text-cta-gold-hover">{company.phoneDisplay}</a></dd></div>
      </div>
      <div class="contact-information-row">
        <span class="contact-information-icon"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current" stroke-width="1.8"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.4"/></svg></span>
        <div class="min-w-0"><dt class="text-sm font-bold">نشانی شرکت</dt><dd class="mt-1 text-base leading-[1.8] text-content-muted">{company.address}</dd></div>
      </div>
      <div class="contact-information-row">
        <span class="contact-information-icon"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6 fill-none stroke-current" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <div class="min-w-0"><dt class="text-sm font-bold">ساعات کاری</dt><dd class="mt-1 space-y-1 text-sm leading-7 text-content-muted">{company.workingHours.map(item => <p>{item.days}: {item.hours}</p>)}</dd></div>
      </div>
    </dl>
  </section>
  <section class="contact-panel" aria-labelledby="contact-location-title">
    <h2 id="contact-location-title" class="contact-section-title"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-cta-gold-hover" stroke-width="1.6"><path d="m3 5 6-2 6 2 6-2v16l-6 2-6-2-6 2V5Zm6-2v16m6-14v16" stroke-linejoin="round"/></svg>موقعیت شرکت</h2>
    <div class="mt-3 overflow-hidden rounded-control border border-border-subtle bg-surface-alt">
      <iframe title={`موقعیت ${company.name} روی نقشه گوگل`} src={`https://www.google.com/maps?q=${encodeURIComponent(coordinates)}&z=17&output=embed`} width="600" height="240" loading="lazy" referrerpolicy="no-referrer" class="block h-60 w-full border-0" allowfullscreen></iframe>
      <p class="px-4 py-3 text-sm leading-7 text-content-muted">{company.address}</p>
    </div>
    <div class="mt-3 flex flex-wrap gap-2" aria-label="باز کردن موقعیت شرکت در مسیریاب">
      {mapLinks.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 flex-1 items-center justify-center whitespace-nowrap rounded-control border border-cta-gold bg-cta-gold/10 px-3 py-2 text-sm font-semibold text-content transition hover:bg-cta-gold/25" aria-label={`باز کردن موقعیت شرکت با ${link.label} (پنجره جدید)`}>باز کردن با {link.label}</a>)}
    </div>
  </section>
</div>
