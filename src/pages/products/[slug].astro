---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomepageHeader from "../../components/HomepageHeader.astro";
import HomepageFooter from "../../components/HomepageFooter.astro";
import ProductGallery from "../../components/product-detail/ProductGallery.astro";
import ProductTables from "../../components/product-detail/ProductTables.astro";
import { company } from "../../data/company";
import { listProductDetails, getProductRecommendations } from "../../lib/product-detail-repository";
import type { ProductDetail } from "../../types/product-detail";
import "../../styles/product-detail.css";
import { isProductIndexable } from "../../lib/product-publication";

export function getStaticPaths() {
  const products = listProductDetails();
  const routes = products.map(product => ({ params: { slug: product.slug }, props: { product, redirectTo: undefined as string | undefined } }));
  // Preserve the earlier preview URL without keeping a second product record.
  const firstProduct = products.find(product => product.slug === "product-1");
  if (firstProduct) routes.push({ params: { slug: "demo-1hm919051m" }, props: { product: firstProduct, redirectTo: "/products/product-1/" } });
  return routes;
}
interface Props { product: ProductDetail; redirectTo?: string }
const { product, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo, 301);
const recommendations = getProductRecommendations(product);
const oem = product.referenceNumbers.find(number => number.kind === "oem")?.value;
const reference = product.referenceNumbers.find(number => number.kind === "part-reference")?.value;
const summaryFields: Array<{ label: string; value: string }> = [];
if (reference && reference === product.sku) {
  summaryFields.push({ label: product.skuKind === "reference-derived-display" ? "شماره مرجع / SKU نمایشی" : "شماره مرجع / SKU", value: reference });
} else {
  if (reference) summaryFields.push({ label: "شماره مرجع قطعه", value: reference });
  if (product.sku) summaryFields.push({ label: product.skuKind === "reference-derived-display" ? "SKU نمایشی" : "کد محصول (SKU)", value: product.sku });
}
if (product.manufacturer) summaryFields.push({ label: "برند عرضه‌کننده", value: product.manufacturer });
if (product.vehicleBrand) summaryFields.push({ label: "برند خودرو", value: product.vehicleBrand });
if (product.category.at(-1)) summaryFields.push({ label: "دسته‌بندی", value: product.category.at(-1)! });
if (oem) summaryFields.push({ label: "کد OEM", value: oem });
const phoneHref = `tel:${company.phone}`;
---
<BaseLayout noindex={!isProductIndexable(product)} title={`${product.name} | ${company.name}`} description={product.dataStatus === "approved" ? product.description : `پیش‌نمایش آزمایشی ${product.name}؛ مشخصات و تصاویر نیازمند تأیید پیش از انتشار هستند.`}>
  <HomepageHeader activePath="/products/" />
  <main class="product-detail" dir="rtl">
    <section class="detail-banner py-5" aria-labelledby="detail-title">
      <div class="detail-container">
        <nav aria-label="مسیر صفحه" class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs leading-6 text-white/70">
          <a href="/" class="hover:text-cta-gold">صفحه اصلی</a><span aria-hidden="true">/</span><a href="/products/" class="hover:text-cta-gold">محصولات</a><span aria-hidden="true">/</span><span aria-current="page" class="text-white">{product.sku ? <bdi dir="ltr">{product.sku}</bdi> : product.name}</span>
        </nav>
        <h1 id="detail-title" class="mt-2 text-xl leading-[1.7] font-black sm:text-2xl">{product.name}</h1>
      </div>
    </section>

    <div class="detail-container pt-4 pb-5">
      {product.dataNotice && <p class="mb-4 border-r-2 border-cta-gold bg-cta-gold/5 px-3 py-2 text-sm leading-7 text-content-muted">{product.dataNotice}</p>}
      <div class="detail-overview">
        <section class="detail-info detail-panel flex flex-col" aria-labelledby="detail-product-name">
          <p class="mb-2 w-fit rounded-full bg-surface-alt px-3 py-1 text-xs text-content-muted">{product.dataStatus === "approved" ? product.category.at(-1) : "رکورد آزمایشی؛ تأییدنشده برای انتشار"}</p>
          <h2 id="detail-product-name" class="text-xl leading-[1.7] font-black sm:text-[22px]">{product.name}</h2>
          {product.category.length > 0 && <p class="mt-2 text-xs leading-6 text-content-muted">{product.category.join(" ← ")}</p>}
          <p data-product-description class="mt-3 text-base leading-[1.8] text-content-muted" dir="rtl"><bdi>{product.description}</bdi></p>
          {summaryFields.length > 0 && <dl class="detail-metadata">
            {summaryFields.map(field => <div><dt>{field.label}</dt><dd><bdi>{field.value}</bdi></dd></div>)}
          </dl>}
          {product.skuKind === "reference-derived-display" && <p class="text-xs leading-6 text-content-muted">SKU نمایشی از شماره مرجع قطعه گرفته شده است؛ SKU داخلی جداگانه شرکت نیست.</p>}
          <div class="detail-actions">
            <a href={phoneHref} class="detail-button bg-cta-gold text-brand-navy transition hover:bg-cta-gold-hover"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 shrink-0 fill-none stroke-current" stroke-width="1.7"><path d="m7 3 3 5-2.2 2.2a15 15 0 0 0 6 6L16 14l5 3-1 4C10 22 2 14 3 4l4-1Z" stroke-linecap="round" stroke-linejoin="round"/></svg>تماس با واحد فروش</a>
            <a href={`/contact/?product=${encodeURIComponent(product.slug)}`} class="detail-button border border-cta-gold text-content transition hover:bg-cta-gold/10"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 shrink-0 fill-none stroke-current" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6" stroke-linejoin="round"/></svg>درخواست اطلاعات محصول</a>
          </div>
        </section>
        <ProductGallery images={product.images} notice={product.imageNotice} />
      </div>

      <ProductTables product={product} />

      {recommendations.products.length > 0 && <section class="mt-5" aria-labelledby="detail-related-title">
        <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
          <h2 id="detail-related-title" class="detail-section-title mb-0">{recommendations.title}</h2>
          <a href="/products/" class="inline-flex min-h-10 items-center gap-2 rounded-full border border-cta-gold px-3 py-2 text-xs font-bold transition hover:bg-cta-gold/10">مشاهده همه محصولات <span aria-hidden="true">←</span></a>
        </div>
        <div class="detail-related">
          {recommendations.products.map(item => <article class="detail-related-card">
            <div class="flex min-w-0 flex-col items-start">
              <p class="text-xs text-content-muted">{item.dataStatus === "approved" ? item.category.at(-1) : "محصول نمایشی"}</p>
              <h3 class="mt-1 text-sm leading-6 font-bold">{item.name}</h3>
              <a href={`/products/${item.slug}/`} class="mt-auto inline-flex min-h-10 max-w-full items-center gap-2 rounded-full border border-cta-gold px-3 py-1.5 text-xs font-bold whitespace-nowrap transition hover:bg-cta-gold/10" aria-label={`مشاهده جزئیات ${item.name}`}>مشاهده جزئیات <span aria-hidden="true" class="text-cta-gold-hover">←</span></a>
            </div>
            {item.images[0] && <img src={item.images[0].src} alt={item.images[0].alt} width={item.images[0].width} height={item.images[0].height} loading="lazy" decoding="async" class="h-28 w-full object-contain" />}
          </article>)}
        </div>
      </section>}

      <section class="detail-contact mt-4 flex flex-col items-start justify-between gap-4 px-5 py-5 lg:flex-row lg:items-center" aria-labelledby="detail-contact-title">
        <div><h2 id="detail-contact-title" class="text-lg leading-8 font-bold">برای انتخاب قطعه مناسب نیاز به راهنمایی دارید؟</h2><p class="mt-1 text-sm leading-7 text-white/75">برای بررسی مشخصات، موجودی و شرایط همکاری با واحد فروش تماس بگیرید.</p></div>
        <a href={phoneHref} class="detail-button shrink-0 bg-cta-gold text-brand-navy transition hover:bg-cta-gold-hover"><svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current" stroke-width="1.7"><path d="m7 3 3 5-2.2 2.2a15 15 0 0 0 6 6L16 14l5 3-1 4C10 22 2 14 3 4l4-1Z" stroke-linecap="round" stroke-linejoin="round"/></svg>تماس با واحد فروش</a>
      </section>
    </div>
  </main>
  <HomepageFooter />
</BaseLayout>

<script>
  import "../../scripts/product-detail";
</script>
