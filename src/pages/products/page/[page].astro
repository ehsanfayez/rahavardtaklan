---
import CatalogPage from "../../../components/catalog/CatalogPage.astro";
import { listCatalogProducts } from "../../../lib/product-detail-repository";
import { PAGE_SIZE } from "../../../lib/catalog";

export function getStaticPaths() {
  const products = listCatalogProducts();
  return Array.from({ length: Math.max(0, Math.ceil(products.length / PAGE_SIZE) - 1) }, (_, index) => ({
    params: { page: String(index + 2) }, props: { initialPage: index + 2 },
  }));
}
const { initialPage } = Astro.props;
---
<CatalogPage initialPage={initialPage} />
