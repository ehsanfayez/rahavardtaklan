---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomepageHeader from "../components/HomepageHeader.astro";
import HomepageFooter from "../components/HomepageFooter.astro";
import ContactRequestForm from "../components/contact/ContactRequestForm.astro";
import CompanyContactInfo from "../components/contact/CompanyContactInfo.astro";
import { company } from "../data/company";
import { listContactProducts } from "../lib/product-detail-repository";
import "../styles/contact.css";

const products = listContactProducts();
---
<BaseLayout title={`تماس با ما | ${company.name}`} description="برای دریافت اطلاعات محصولات و بررسی شرایط همکاری با واحد فروش رهاورد تکلان در ارتباط باشید.">
  <HomepageHeader activePath="/contact/" />
  <main class="contact-page" dir="rtl">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="contact-container py-5 sm:py-6">
        <nav class="flex flex-wrap items-center gap-2 text-xs leading-5 text-white/70" aria-label="مسیر صفحه"><a href="/" class="transition hover:text-cta-gold">صفحه اصلی</a><span aria-hidden="true">/</span><span aria-current="page" class="text-white">تماس با ما</span></nav>
        <h1 id="contact-title" class="mt-3 text-2xl leading-[1.6] font-black sm:text-3xl"><span class="text-cta-gold">ارتباط</span> با {company.name}</h1>
        <p class="mt-2 max-w-3xl text-base leading-[1.8] text-white/85">برای دریافت اطلاعات محصولات و بررسی شرایط همکاری با واحد فروش در ارتباط باشید.</p>
      </div>
    </section>
    <div class="contact-container py-5 sm:py-6">
      <div class="contact-layout">
        <ContactRequestForm products={products} />
        <CompanyContactInfo />
      </div>
    </div>
  </main>
  <HomepageFooter />
</BaseLayout>
<script>
  import "../scripts/contact";
</script>
