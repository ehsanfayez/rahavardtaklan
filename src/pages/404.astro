---
import HomepageFooter from "../components/HomepageFooter.astro";
import HomepageHeader from "../components/HomepageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { company } from "../data/company";
---

<BaseLayout noindex title={`صفحه پیدا نشد | ${company.name}`} description="صفحه موردنظر پیدا نشد. به صفحه اصلی کاتالوگ رهاورد تکلان بازگردید.">
  <HomepageHeader activePath="/404/" />
  <main class="flex min-h-[58vh] flex-col items-center justify-center px-5 py-16 text-center">
    <span class="font-mono text-xs tracking-[0.2em] text-content-muted" dir="ltr">ERROR / 404</span>
    <h1 class="mt-4 text-3xl leading-relaxed font-black text-ink sm:text-4xl">این صفحه در کاتالوگ پیدا نشد</h1>
    <p class="mt-3 max-w-md text-sm leading-7 text-muted">ممکن است نشانی تغییر کرده باشد یا صفحه در دسترس نباشد.</p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-flex min-h-11 items-center gap-3 rounded-control bg-cta-gold px-5 py-3 text-sm font-bold text-brand-navy transition hover:bg-cta-gold-hover">بازگشت به صفحه اصلی <span aria-hidden="true">←</span></a>
      <a href="/products/" class="inline-flex min-h-11 items-center rounded-control border border-cta-gold px-5 py-3 text-sm font-bold text-content transition hover:bg-cta-gold/10">مشاهده کاتالوگ</a>
    </div>
  </main>
  <HomepageFooter />
</BaseLayout>
