---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "رهاورد تکلان | کاتالوگ قطعات خودرو",
  description = "کاتالوگ معرفی B2B محصولات مرتبط با پمپ بنزین و مجموعه درجه باک خودرو.",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-page text-ink antialiased transition-colors duration-200">
    <slot />
  </body>
</html>
